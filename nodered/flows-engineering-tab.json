    {
        "id": "eng-calc-log",
        "type": "ui_template",
        "z": "eng-tools-tab",
        "group": "eng-log-group",
        "name": "Calculation Log",
        "order": 1,
        "width": 15,
        "height": 8,
        "format": "<div class=\"cl-wrap\">\n  <div class=\"cl-empty\" ng-if=\"!rows.length\">\n    No calculations yet &mdash; press <b>Send to flow</b> on any tool.\n  </div>\n\n  <div class=\"cl-row\" ng-repeat=\"r in rows track by r.id\">\n    <div class=\"cl-top\">\n      <span class=\"cl-tool\">{{ r.label }}</span>\n      <span class=\"cl-ts\">{{ r.ts }}</span>\n    </div>\n    <div class=\"cl-vals\">{{ r.summary }}</div>\n  </div>\n</div>\n\n<style>\n  .cl-wrap { font-family: 'Segoe UI', Arial, sans-serif; max-height: 300px; overflow-y: auto; padding: 2px; }\n  .cl-empty { color: #4d699a; font-size: .78rem; padding: 10px 4px; }\n  .cl-row { border-left: 2px solid #00d4ff55; background: #081530; border-radius: 6px;\n    padding: 6px 9px; margin-bottom: 6px; }\n  .cl-row:hover { border-left-color: #00d4ff; }\n  .cl-top { display: flex; justify-content: space-between; align-items: baseline; }\n  .cl-tool { color: #7fe3ff; font-size: .76rem; font-weight: 600; }\n  .cl-ts { color: #4d699a; font-size: .62rem; font-family: Consolas, monospace; }\n  .cl-vals { color: #a8c4f0; font-size: .72rem; font-family: Consolas, monospace;\n    margin-top: 3px; line-height: 1.45; word-break: break-word; }\n  .cl-wrap::-webkit-scrollbar { width: 6px; }\n  .cl-wrap::-webkit-scrollbar-thumb { background: #1e3a6e; border-radius: 3px; }\n</style>\n\n<script>\n  (function (scope) {\n    scope.rows = scope.rows || [];\n    var MAX = 12;\n\n    var LABEL = {\n      three_phase: 'Three-Phase Power', energy_cost: 'Energy & Cost',\n      ct_pt: 'CT / PT Scaling', voltage_drop: 'Voltage Drop',\n      pf_correction: 'PF Correction', transformer: 'Transformer Sizing',\n      motor_fla: 'Motor FLA', load_factor: 'Load & Loss Factor'\n    };\n\n    function n(v, d) {\n      if (v === undefined || v === null || isNaN(v)) return '—';\n      return Number(v).toFixed(d === undefined ? 1 : d);\n    }\n\n    function summarise(tool, o) {\n      o = o || {};\n      switch (tool) {\n        case 'three_phase':  return n(o.kva,1) + ' kVA · ' + n(o.kw,2) + ' kW · ' + n(o.kvar,2) + ' kVAR';\n        case 'energy_cost':  return n(o.kwhDay,1) + ' kWh/day · ' + n(o.kwhMonth,0) + ' kWh/mo · ' + n(o.costMonth,0) + ' cost/mo';\n        case 'ct_pt':        return 'multiplier ' + n(o.mult,2) + ' · primary ' + n(o.primary,1);\n        case 'voltage_drop': return n(o.vd,2) + ' V (' + n(o.pct,2) + '%)';\n        case 'pf_correction':return n(o.kvar,1) + ' kVAR needed · ' + n(o.saved,1) + ' kVA released';\n        case 'transformer':  return n(o.required,1) + ' kVA required → ' + n(o.std,0) + ' kVA std @ ' + n(o.loading,1) + '%';\n        case 'motor_fla':    return n(o.fla,2) + ' A FLA · ' + n(o.starter,2) + ' A DOL inrush';\n        case 'load_factor':  return n(o.lf,1) + '% load factor · ' + n(o.annual,0) + ' kWh/yr';\n        default:             return JSON.stringify(o);\n      }\n    }\n\n    scope.$watch('msg', function (msg) {\n      if (!msg || !msg.payload || !msg.payload.tool) return;\n      var p = msg.payload;\n      var t = new Date(p.ts || Date.now());\n      scope.rows.unshift({\n        id: p.id || (Date.now() + Math.random()),\n        tool: p.tool,\n        label: LABEL[p.tool] || p.tool,\n        ts: t.toLocaleTimeString(),\n        summary: summarise(p.tool, p.outputs)\n      });\n      if (scope.rows.length > MAX) scope.rows.length = MAX;\n    });\n  })(scope);\n</script>\n",
