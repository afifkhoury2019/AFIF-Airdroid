        "func": "var p = msg.payload || {};\nvar out = {\n  id: (Date.now().toString(36) + Math.random().toString(36).slice(2,6)),\n  ts: new Date().toISOString(),\n  tool: p.tool || (msg.topic || '').replace('eng/',''),\n  inputs: p.inputs || {},\n  outputs: p.outputs || {}\n};\nmsg.payload = out;\nmsg.topic = 'eng/' + out.tool;\nnode.status({fill:'green', shape:'dot', text: out.tool});\nreturn msg;",
