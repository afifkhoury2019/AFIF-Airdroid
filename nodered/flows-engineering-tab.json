    {
        "id": "eng-access-window",
        "type": "ui_template",
        "z": "eng-tools-tab",
        "group": "eng-access-group",
        "name": "Access Window",
        "order": 1,
        "width": 30,
        "height": 18,
        "format": "<div class=\"aw-shell\" ng-class=\"{'aw-full': isFull}\">\n  <div class=\"aw-card\">\n\n    <div class=\"aw-head\">\n      <span class=\"aw-led\" ng-class=\"state\"></span>\n      <div class=\"aw-titles\">\n        <h3>{{ title }}</h3>\n        <span class=\"aw-sub\">{{ subtitle }}</span>\n      </div>\n      <div class=\"aw-actions\">\n        <button class=\"aw-btn\" ng-click=\"reload()\" title=\"Reload\">&#8635;</button>\n        <button class=\"aw-btn\" ng-click=\"toggleFull()\" title=\"Maximise\">{{ isFull ? '&#10006;' : '&#10530;' }}</button>\n        <button class=\"aw-btn\" ng-click=\"popout()\" title=\"Open in new tab\">&#8599;</button>\n      </div>\n    </div>\n\n    <div class=\"aw-bar\">\n      <input class=\"aw-url\" type=\"text\" ng-model=\"draft\" ng-keydown=\"$event.keyCode===13 && go()\"\n             spellcheck=\"false\" placeholder=\"https://powerchain.uk/ui/#!/5\" />\n      <button class=\"aw-btn aw-go\" ng-click=\"go()\">Open</button>\n      <select class=\"aw-sel\" ng-model=\"preset\" ng-change=\"applyPreset()\">\n        <option value=\"\">Presets…</option>\n        <option value=\"eng\">Engineering tab (#5)</option>\n        <option value=\"home\">Dashboard home</option>\n        <option value=\"phone\">Phone agent (LAN)</option>\n        <option value=\"custom\">Custom…</option>\n      </select>\n    </div>\n\n    <div class=\"aw-body\">\n      <iframe ng-if=\"src && !blocked\" class=\"aw-frame\" ng-attr-src=\"{{ src }}\"\n              referrerpolicy=\"same-origin\" allow=\"fullscreen; clipboard-read; clipboard-write\"></iframe>\n\n      <div class=\"aw-placeholder\" ng-if=\"!src\">\n        <div class=\"aw-ph-icon\">&#9783;</div>\n        <p>No target loaded.</p>\n        <p class=\"aw-hint\">Send <code>msg.src</code> (plus optional <code>msg.title</code>) into this node,\n          or pick a preset above.</p>\n      </div>\n\n      <div class=\"aw-placeholder aw-warn\" ng-if=\"blocked\">\n        <div class=\"aw-ph-icon\">&#9888;</div>\n        <p>{{ blockedReason }}</p>\n        <p class=\"aw-hint\">Browsers refuse <code>http://</code> frames inside an <code>https://</code> dashboard\n          (mixed content). Use an <code>https</code> target or a reverse proxy.</p>\n        <button class=\"aw-btn aw-go\" ng-click=\"popout()\">Open in a new tab instead</button>\n      </div>\n    </div>\n\n    <div class=\"aw-foot\">\n      <span class=\"aw-status\" ng-class=\"state\">{{ statusText }}</span>\n      <span class=\"aw-spacer\"></span>\n      <span class=\"aw-meta\">{{ lastLoad || '—' }}</span>\n    </div>\n\n  </div>\n</div>\n\n<style>\n  .aw-shell { width: 100%; height: 100%; min-height: 520px; box-sizing: border-box; padding: 0 4px; }\n  .aw-shell.aw-full { position: fixed; inset: 0; z-index: 9999; background: #070f1e; padding: 8px; }\n\n  .aw-card {\n    display: flex; flex-direction: column; height: 100%;\n    background: linear-gradient(160deg, #0f1c3a 0%, #0a1428 100%);\n    border: 1px solid #1e3a6e; border-radius: 12px;\n    box-shadow: 0 8px 26px rgba(0, 0, 40, 0.65);\n    overflow: hidden; font-family: 'Segoe UI', Arial, sans-serif;\n  }\n\n  .aw-head { display: flex; align-items: center; gap: 10px; padding: 10px 14px;\n    background: #0b1e4a; border-bottom: 1px solid #1e3a6e; }\n  .aw-titles { display: flex; flex-direction: column; min-width: 0; flex: 1; }\n  .aw-titles h3 { margin: 0; font-size: 1rem; font-weight: 600; color: #e0f0ff;\n    white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }\n  .aw-sub { font-size: .72rem; color: #6f8cc4; white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }\n\n  .aw-led { width: 9px; height: 9px; border-radius: 50%; flex: none;\n    background: #4a5f8a; box-shadow: 0 0 0 3px rgba(74,95,138,.18); }\n  .aw-led.ok { background: #00e676; box-shadow: 0 0 8px #00e67699; }\n  .aw-led.busy { background: #ffb300; box-shadow: 0 0 8px #ffb30099; }\n  .aw-led.err { background: #ff5252; box-shadow: 0 0 8px #ff525299; }\n\n  .aw-actions { display: flex; gap: 6px; }\n  .aw-btn { background: #12294f; color: #a0d0ff; border: 1px solid #24467f;\n    border-radius: 7px; padding: 5px 10px; cursor: pointer; font-size: .85rem; line-height: 1;\n    transition: all .18s ease; }\n  .aw-btn:hover { background: #1b3a6b; color: #7fe3ff; border-color: #00d4ff88; }\n  .aw-btn.aw-go { background: #00496b; color: #7fe3ff; border-color: #007ea8; font-weight: 600; }\n\n  .aw-bar { display: flex; gap: 8px; padding: 8px 12px; background: #081530;\n    border-bottom: 1px solid #16305c; }\n  .aw-url { flex: 1; min-width: 0; background: #050d1d; color: #9fc4ff;\n    border: 1px solid #1e3a6e; border-radius: 7px; padding: 6px 10px; font-size: .78rem;\n    font-family: Consolas, monospace; outline: none; }\n  .aw-url:focus { border-color: #00d4ff88; }\n  .aw-sel { background: #12294f; color: #a0d0ff; border: 1px solid #24467f;\n    border-radius: 7px; padding: 6px 8px; font-size: .78rem; }\n\n  .aw-body { position: relative; flex: 1; min-height: 380px; background: #060e1e; }\n  .aw-frame { width: 100%; height: 100%; min-height: 380px; border: 0; display: block; background: #060e1e; }\n\n  .aw-placeholder { position: absolute; inset: 0; display: flex; flex-direction: column;\n    align-items: center; justify-content: center; gap: 6px; text-align: center;\n    color: #7f9dd0; padding: 24px; }\n  .aw-placeholder.aw-warn { color: #ffcf6b; }\n  .aw-ph-icon { font-size: 2.4rem; opacity: .55; }\n  .aw-hint { font-size: .78rem; color: #5f7bad; max-width: 460px; }\n  .aw-hint code { background: #0e1f3d; padding: 1px 5px; border-radius: 4px; color: #8fd4ff; }\n\n  .aw-foot { display: flex; align-items: center; gap: 8px; padding: 6px 12px;\n    background: #081530; border-top: 1px solid #16305c; font-size: .72rem; }\n  .aw-status { color: #6f8cc4; }\n  .aw-status.ok { color: #00e676; }\n  .aw-status.busy { color: #ffb300; }\n  .aw-status.err { color: #ff5252; }\n  .aw-spacer { flex: 1; }\n  .aw-meta { color: #4d699a; font-family: Consolas, monospace; }\n</style>\n\n<script>\n  (function (scope) {\n    scope.title = scope.title || 'Access Window';\n    scope.subtitle = scope.subtitle || 'Embedded console';\n    scope.draft = scope.src || '';\n    scope.state = '';\n    scope.statusText = 'idle';\n    scope.isFull = false;\n    scope.blocked = false;\n    scope.preset = '';\n\n    var PRESETS = {\n      eng:   { src: 'https://powerchain.uk/ui/#!/5', title: 'Engineering Tools' },\n      home:  { src: 'https://powerchain.uk/ui/',      title: 'PowerChain Dashboard' },\n      phone: { src: 'https://',                       title: 'Phone Agent' }\n    };\n\n    function setState(s, text) {\n      scope.state = s;\n      scope.statusText = text;\n    }\n\n    scope.load = function (url, label) {\n      if (!url) { scope.blocked = false; return; }\n      scope.blocked = false;\n      // Mixed-content guard: an https dashboard cannot frame an http origin.\n      var pageHttps = (location.protocol === 'https:');\n      if (pageHttps && /^http:\\/\\//i.test(url)) {\n        scope.blocked = true;\n        scope.blockedReason = 'Blocked: \"' + url + '\" is http:// inside an https:// dashboard.';\n        setState('err', 'mixed content');\n        return;\n      }\n      scope.src = url;\n      if (label) scope.title = label;\n      scope.draft = url;\n      scope.lastLoad = new Date().toLocaleTimeString();\n      setState('busy', 'loading…');\n      // No reliable load event cross-origin; treat as up shortly after assignment.\n      setTimeout(function () { setState('ok', 'connected'); }, 1200);\n    };\n\n    scope.reload = function () {\n      if (!scope.src) return;\n      var s = scope.src;\n      scope.src = '';\n      setState('busy', 'reloading…');\n      setTimeout(function () { scope.src = s; setState('ok', 'connected'); }, 120);\n    };\n\n    scope.go = function () { scope.load(scope.draft, scope.title); };\n\n    scope.applyPreset = function () {\n      var p = PRESETS[scope.preset];\n      if (!p) return;\n      if (scope.preset === 'phone') {\n        var host = window.prompt('Phone agent address (LAN), e.g. 192.168.1.42:8080', '192.168.1.42:8080');\n        if (host) scope.load('http://' + host + '/', 'Phone Agent');\n        return;\n      }\n      scope.load(p.src, p.title);\n    };\n\n    scope.toggleFull = function () { scope.isFull = !scope.isFull; };\n\n    scope.popout = function () {\n      if (scope.src) window.open(scope.src, '_blank', 'noopener');\n    };\n\n    // Node-RED input\n    scope.$watch('msg', function (msg) {\n      if (!msg) return;\n      if (msg.src) scope.load(msg.src, msg.title);\n      else if (msg.title) scope.title = msg.title;\n      if (msg.reload) scope.reload();\n      if (msg.fullscreen !== undefined) scope.isFull = !!msg.fullscreen;\n    });\n  })(scope);\n</script>\n",
        "storeOutMessages": true,
        "fwdInMessages": true,
        "resendOnRefresh": true,
        "templateScope": "local",
        "x": 380,
        "y": 140,
        "wires": [
            []
        ]
    },
    {
        "id": "eng-target-inject",
        "type": "inject",
        "z": "eng-tools-tab",
        "name": "Default target",
        "props": [
            {
                "p": "payload"
            }
        ],
        "repeat": "",
        "crontab": "",
        "once": true,
        "onceDelay": 0.6,
        "topic": "",
        "payload": "{\"src\":\"https://powerchain.uk/ui/#!/5\",\"title\":\"Engineering Tools\"}",
        "payloadType": "json",
        "x": 160,
        "y": 140,
        "wires": [
            [
                "eng-target-fn"
            ]
        ]
    },
    {
        "id": "eng-target-fn",
        "type": "function",
        "z": "eng-tools-tab",
        "name": "Set window target",
        "func": "// Accepts a URL string, {src,title}, or passes the current msg through.\nvar p = msg.payload;\nif (typeof p === 'string') { msg.src = p; }\nelse if (p && typeof p === 'object') {\n  if (p.src) msg.src = p.src;\n  if (p.title) msg.title = p.title;\n  if (p.reload !== undefined) msg.reload = p.reload;\n}\nif (!msg.src && !msg.title && !msg.reload) return null;\nreturn msg;",
        "outputs": 1,
        "timeout": "",
        "noerr": 0,
        "initialize": "",
        "finalize": "",
        "libs": [],
        "x": 380,
        "y": 220,
        "wires": [
            [
                "eng-access-window"
            ]
        ]
    },
    {
        "id": "eng-toolkit",
        "type": "ui_template",
        "z": "eng-tools-tab",
        "group": "eng-tools-group",
        "name": "Engineering Toolkit",
        "order": 1,
        "width": 30,
        "height": 14,
        "format": "<div class=\"et-wrap\">\n  <div class=\"et-head\">\n    <h2>Engineering Toolkit</h2>\n    <span class=\"et-count\">{{ tools.length }} tools &middot; live</span>\n  </div>\n\n  <div class=\"et-grid\">\n\n    <!-- 1. Three-phase power -->\n    <div class=\"et-card\">\n      <div class=\"et-title\"><span>&#9889;</span> Three-Phase Power</div>\n      <label>Voltage L-L (V)<input type=\"number\" ng-model=\"t.p1.v\" ng-change=\"calcAll()\"></label>\n      <label>Current (A)<input type=\"number\" ng-model=\"t.p1.i\" ng-change=\"calcAll()\"></label>\n      <label>Power factor<input type=\"number\" step=\"0.01\" min=\"0\" max=\"1\" ng-model=\"t.p1.pf\" ng-change=\"calcAll()\"></label>\n      <div class=\"et-out\">\n        <div><b>{{ fmt(o.p1.kva,1) }}</b><i>kVA</i></div>\n        <div><b>{{ fmt(o.p1.kw,2) }}</b><i>kW</i></div>\n        <div><b>{{ fmt(o.p1.kvar,2) }}</b><i>kVAR</i></div>\n      </div>\n      <button class=\"et-btn\" ng-click=\"log('three_phase')\">Send to flow</button>\n    </div>\n\n    <!-- 2. Energy & cost -->\n    <div class=\"et-card\">\n      <div class=\"et-title\"><span>&#128176;</span> Energy &amp; Cost</div>\n      <label>Load (kW)<input type=\"number\" ng-model=\"t.p2.kw\" ng-change=\"calcAll()\"></label>\n      <label>Hours / day<input type=\"number\" ng-model=\"t.p2.h\" ng-change=\"calcAll()\"></label>\n      <label>Tariff (per kWh)<input type=\"number\" step=\"0.001\" ng-model=\"t.p2.tariff\" ng-change=\"calcAll()\"></label>\n      <div class=\"et-out\">\n        <div><b>{{ fmt(o.p2.kwhDay,1) }}</b><i>kWh/day</i></div>\n        <div><b>{{ fmt(o.p2.kwhMonth,0) }}</b><i>kWh/mo</i></div>\n        <div><b>{{ fmt(o.p2.costMonth,0) }}</b><i>cost/mo</i></div>\n      </div>\n      <button class=\"et-btn\" ng-click=\"log('energy_cost')\">Send to flow</button>\n    </div>\n\n    <!-- 3. CT / PT scaling -->\n    <div class=\"et-card\">\n      <div class=\"et-title\"><span>&#128207;</span> CT / PT Scaling</div>\n      <label>CT primary (A)<input type=\"number\" ng-model=\"t.p3.ctp\" ng-change=\"calcAll()\"></label>\n      <label>CT secondary (A)<input type=\"number\" ng-model=\"t.p3.cts\" ng-change=\"calcAll()\"></label>\n      <label>PT primary (V)<input type=\"number\" ng-model=\"t.p3.ptp\" ng-change=\"calcAll()\"></label>\n      <label>PT secondary (V)<input type=\"number\" ng-model=\"t.p3.pts\" ng-change=\"calcAll()\"></label>\n      <label>Meter reading<input type=\"number\" ng-model=\"t.p3.rdg\" ng-change=\"calcAll()\"></label>\n      <div class=\"et-out\">\n        <div><b>{{ fmt(o.p3.mult,2) }}</b><i>multiplier</i></div>\n        <div><b>{{ fmt(o.p3.primary,1) }}</b><i>primary value</i></div>\n      </div>\n      <button class=\"et-btn\" ng-click=\"log('ct_pt')\">Send to flow</button>\n    </div>\n\n    <!-- 4. Voltage drop -->\n    <div class=\"et-card\">\n      <div class=\"et-title\"><span>&#128268;</span> Voltage Drop</div>\n      <label>Current (A)<input type=\"number\" ng-model=\"t.p4.i\" ng-change=\"calcAll()\"></label>\n      <label>Length (m)<input type=\"number\" ng-model=\"t.p4.l\" ng-change=\"calcAll()\"></label>\n      <label>Resistance (&Omega;/km)<input type=\"number\" step=\"0.001\" ng-model=\"t.p4.r\" ng-change=\"calcAll()\"></label>\n      <label>Reactance (&Omega;/km)<input type=\"number\" step=\"0.001\" ng-model=\"t.p4.x\" ng-change=\"calcAll()\"></label>\n      <label>Power factor<input type=\"number\" step=\"0.01\" ng-model=\"t.p4.pf\" ng-change=\"calcAll()\"></label>\n      <label>System voltage (V)<input type=\"number\" ng-model=\"t.p4.v\" ng-change=\"calcAll()\"></label>\n      <div class=\"et-out\">\n        <div><b>{{ fmt(o.p4.vd,2) }}</b><i>V drop</i></div>\n        <div><b ng-class=\"o.p4.pct > 5 ? 'et-bad' : 'et-good'\">{{ fmt(o.p4.pct,2) }}%</b><i>of nominal</i></div>\n      </div>\n      <button class=\"et-btn\" ng-click=\"log('voltage_drop')\">Send to flow</button>\n    </div>\n\n    <!-- 5. PF correction -->\n    <div class=\"et-card\">\n      <div class=\"et-title\"><span>&#8645;</span> PF Correction</div>\n      <label>Load (kW)<input type=\"number\" ng-model=\"t.p5.kw\" ng-change=\"calcAll()\"></label>\n      <label>Existing PF<input type=\"number\" step=\"0.01\" min=\"0.1\" max=\"1\" ng-model=\"t.p5.pf1\" ng-change=\"calcAll()\"></label>\n      <label>Target PF<input type=\"number\" step=\"0.01\" min=\"0.1\" max=\"1\" ng-model=\"t.p5.pf2\" ng-change=\"calcAll()\"></label>\n      <div class=\"et-out\">\n        <div><b>{{ fmt(o.p5.kvar,1) }}</b><i>kVAR needed</i></div>\n        <div><b>{{ fmt(o.p5.saved,1) }}</b><i>kVA released</i></div>\n      </div>\n      <button class=\"et-btn\" ng-click=\"log('pf_correction')\">Send to flow</button>\n    </div>\n\n    <!-- 6. Transformer sizing -->\n    <div class=\"et-card\">\n      <div class=\"et-title\"><span>&#128260;</span> Transformer Sizing</div>\n      <label>Connected load (kVA)<input type=\"number\" ng-model=\"t.p6.kva\" ng-change=\"calcAll()\"></label>\n      <label>Demand factor<input type=\"number\" step=\"0.05\" ng-model=\"t.p6.df\" ng-change=\"calcAll()\"></label>\n      <label>Spare capacity (%)<input type=\"number\" ng-model=\"t.p6.spare\" ng-change=\"calcAll()\"></label>\n      <div class=\"et-out\">\n        <div><b>{{ fmt(o.p6.required,1) }}</b><i>kVA required</i></div>\n        <div><b>{{ fmt(o.p6.std,0) }}</b><i>next std size</i></div>\n        <div><b>{{ fmt(o.p6.loading,1) }}%</b><i>loading</i></div>\n      </div>\n      <button class=\"et-btn\" ng-click=\"log('transformer')\">Send to flow</button>\n    </div>\n\n    <!-- 7. Motor FLA -->\n    <div class=\"et-card\">\n      <div class=\"et-title\"><span>&#9881;</span> Motor Full-Load Amps</div>\n      <label>Rated power (kW)<input type=\"number\" ng-model=\"t.p7.kw\" ng-change=\"calcAll()\"></label>\n      <label>Voltage (V)<input type=\"number\" ng-model=\"t.p7.v\" ng-change=\"calcAll()\"></label>\n      <label>Power factor<input type=\"number\" step=\"0.01\" ng-model=\"t.p7.pf\" ng-change=\"calcAll()\"></label>\n      <label>Efficiency<input type=\"number\" step=\"0.01\" ng-model=\"t.p7.eff\" ng-change=\"calcAll()\"></label>\n      <div class=\"et-out\">\n        <div><b>{{ fmt(o.p7.fla,2) }}</b><i>A</i></div>\n        <div><b>{{ fmt(o.p7.starter,2) }}</b><i>DOL inrush (6x)</i></div>\n      </div>\n      <button class=\"et-btn\" ng-click=\"log('motor_fla')\">Send to flow</button>\n    </div>\n\n    <!-- 8. Load factor -->\n    <div class=\"et-card\">\n      <div class=\"et-title\"><span>&#128200;</span> Load &amp; Loss Factor</div>\n      <label>Peak demand (kW)<input type=\"number\" ng-model=\"t.p8.peak\" ng-change=\"calcAll()\"></label>\n      <label>Average demand (kW)<input type=\"number\" ng-model=\"t.p8.avg\" ng-change=\"calcAll()\"></label>\n      <div class=\"et-out\">\n        <div><b>{{ fmt(o.p8.lf,1) }}%</b><i>load factor</i></div>\n        <div><b>{{ fmt(o.p8.annual,0) }}</b><i>kWh / yr @ 8760h</i></div>\n      </div>\n      <button class=\"et-btn\" ng-click=\"log('load_factor')\">Send to flow</button>\n    </div>\n\n  </div>\n\n  <div class=\"et-foot\">\n    <span class=\"et-muted\">Values are indicative &mdash; verify against IEC 60364 / your utility rules before design use.</span>\n  </div>\n</div>\n\n<style>\n  .et-wrap { padding: 8px 4px 4px; font-family: 'Segoe UI', Arial, sans-serif; color: #c8d8ff; }\n  .et-head { display: flex; align-items: baseline; gap: 12px; margin: 0 4px 14px; }\n  .et-head h2 { margin: 0; font-size: 1.35rem; color: #00d4ff; font-weight: 600; }\n  .et-count { font-size: .75rem; color: #6f8cc4; }\n\n  .et-grid { display: grid; grid-template-columns: repeat(auto-fit, minmax(240px, 1fr)); gap: 14px; }\n\n  .et-card { background: linear-gradient(150deg, #0f1e3a, #0a1425);\n    border: 1px solid #1e3a5a; border-radius: 12px; padding: 14px;\n    box-shadow: 0 4px 16px rgba(0,0,20,.55); transition: border-color .2s, box-shadow .2s; }\n  .et-card:hover { border-color: #00d4ff66; box-shadow: 0 8px 22px rgba(0,212,255,.14); }\n\n  .et-title { display: flex; align-items: center; gap: 7px; font-weight: 600;\n    color: #e0f0ff; font-size: .95rem; margin-bottom: 10px; }\n  .et-title span { font-size: 1.05rem; }\n\n  .et-card label { display: block; font-size: .72rem; color: #7f9dd0;\n    margin-bottom: 7px; text-transform: uppercase; letter-spacing: .03em; }\n  .et-card input { display: block; width: 100%; margin-top: 3px; box-sizing: border-box;\n    background: #050d1d; border: 1px solid #1e3a6e; border-radius: 6px;\n    color: #9fc4ff; padding: 5px 8px; font-size: .85rem; font-family: Consolas, monospace;\n    outline: none; text-transform: none; }\n  .et-card input:focus { border-color: #00d4ff88; }\n\n  .et-out { display: grid; grid-template-columns: repeat(3, 1fr); gap: 6px;\n    margin: 10px 0 8px; text-align: center; }\n  .et-out div { background: #081530; border: 1px solid #16305c; border-radius: 7px; padding: 6px 3px; }\n  .et-out b { display: block; color: #7fe3ff; font-size: .95rem; font-family: Consolas, monospace; }\n  .et-out i { display: block; font-style: normal; font-size: .62rem; color: #5f7bad; margin-top: 2px; }\n  .et-out .et-good { color: #00e676; }\n  .et-out .et-bad { color: #ff5252; }\n\n  .et-btn { width: 100%; background: #12294f; color: #a0d0ff; border: 1px solid #24467f;\n    border-radius: 7px; padding: 7px; cursor: pointer; font-size: .78rem; font-weight: 600;\n    transition: all .18s; }\n  .et-btn:hover { background: #00496b; color: #7fe3ff; border-color: #007ea8; }\n\n  .et-foot { margin-top: 12px; }\n  .et-muted { font-size: .7rem; color: #4d699a; }\n</style>\n\n<script>\n  (function (scope) {\n    scope.t = {\n      p1: { v: 415, i: 250, pf: 0.92 },\n      p2: { kw: 120, h: 8, tariff: 0.12 },\n      p3: { ctp: 400, cts: 5, ptp: 11000, pts: 110, rdg: 1523.4 },\n      p4: { i: 160, l: 85, r: 0.161, x: 0.08, pf: 0.9, v: 415 },\n      p5: { kw: 300, pf1: 0.78, pf2: 0.95 },\n      p6: { kva: 800, df: 0.8, spare: 20 },\n      p7: { kw: 55, v: 415, pf: 0.86, eff: 0.94 },\n      p8: { peak: 420, avg: 265 }\n    };\n    scope.o = {};\n    scope.tools = [1,2,3,4,5,6,7,8];\n\n    var STD_KVA = [25,50,75,100,160,200,250,315,400,500,630,800,1000,1250,1600,2000,2500];\n\n    function nextStd(x) {\n      for (var i = 0; i < STD_KVA.length; i++) { if (STD_KVA[i] >= x) return STD_KVA[i]; }\n      return STD_KVA[STD_KVA.length - 1];\n    }\n\n    scope.fmt = function (v, d) {\n      if (v === undefined || v === null || isNaN(v) || !isFinite(v)) return '—';\n      return Number(v).toFixed(d === undefined ? 1 : d);\n    };\n\n    scope.calcAll = function () {\n      var t = scope.t, o = {};\n\n      // 1. Three-phase power\n      var s1 = Math.sqrt(3) * t.p1.v * t.p1.i / 1000;\n      o.p1 = { kva: s1, kw: s1 * t.p1.pf, kvar: s1 * Math.sin(Math.acos(Math.min(1, Math.max(0, t.p1.pf)))) };\n\n      // 2. Energy & cost\n      var kwhDay = t.p2.kw * t.p2.h;\n      o.p2 = { kwhDay: kwhDay, kwhMonth: kwhDay * 30.44, costMonth: kwhDay * 30.44 * t.p2.tariff };\n\n      // 3. CT / PT\n      var mult = (t.p3.ctp / t.p3.cts) * (t.p3.ptp / t.p3.pts);\n      o.p3 = { mult: mult, primary: t.p3.rdg * mult };\n\n      // 4. Voltage drop (three-phase, per phase approximation)\n      var lk = t.p4.l / 1000;\n      var sinPhi = Math.sin(Math.acos(Math.min(1, Math.max(0, t.p4.pf))));\n      var vd = Math.sqrt(3) * t.p4.i * (lk * t.p4.r * t.p4.pf + lk * t.p4.x * sinPhi);\n      o.p4 = { vd: vd, pct: t.p4.v ? (vd / t.p4.v) * 100 : 0 };\n\n      // 5. PF correction\n      var tan1 = Math.tan(Math.acos(Math.min(1, Math.max(0.01, t.p5.pf1))));\n      var tan2 = Math.tan(Math.acos(Math.min(1, Math.max(0.01, t.p5.pf2))));\n      var kvar = t.p5.kw * (tan1 - tan2);\n      o.p5 = { kvar: kvar, saved: (t.p5.kw / t.p5.pf1) - (t.p5.kw / t.p5.pf2) };\n\n      // 6. Transformer sizing\n      var req = t.p6.kva * t.p6.df * (1 + t.p6.spare / 100);\n      var std = nextStd(req);\n      o.p6 = { required: req, std: std, loading: std ? (req / std) * 100 : 0 };\n\n      // 7. Motor FLA\n      var fla = (t.p7.kw * 1000) / (Math.sqrt(3) * t.p7.v * t.p7.pf * t.p7.eff);\n      o.p7 = { fla: fla, starter: fla * 6 };\n\n      // 8. Load factor\n      o.p8 = { lf: t.p8.peak ? (t.p8.avg / t.p8.peak) * 100 : 0, annual: t.p8.avg * 8760 };\n\n      scope.o = o;\n    };\n\n    scope.log = function (tool) {\n      var map = {\n        three_phase: 'p1', energy_cost: 'p2', ct_pt: 'p3', voltage_drop: 'p4',\n        pf_correction: 'p5', transformer: 'p6', motor_fla: 'p7', load_factor: 'p8'\n      };\n      var k = map[tool];\n      scope.send({\n        topic: 'eng/' + tool,\n        payload: {\n          tool: tool,\n          inputs: JSON.parse(JSON.stringify(scope.t[k])),\n          outputs: scope.o[k]\n        }\n      });\n    };\n\n    scope.calcAll();\n  })(scope);\n</script>\n",
